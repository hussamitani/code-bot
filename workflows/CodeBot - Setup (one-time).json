    {
      "parameters": {
        "jsCode": "// Rows that codebot_settings needs. Keys that already exist stay untouched, so the workflow can run again safely.\n// Fill in the empty values in n8n under \"Data tables\" afterwards.\nconst ROWS = [\n  { key: 'telegram_bot_token', value: '' },             // token of your bot from @BotFather\n  { key: 'telegram_chat_id', value: '' },               // the only chat the system serves and writes to\n  { key: 'calendar_id', value: '' },                    // calendar for deadlines and planning sessions\n  { key: 'timezone', value: '' },                       // IANA time zone, e.g. Europe/Berlin\n  { key: 'ready_label', value: 'ready-for-agent' },     // label that releases a ticket for a worker\n];\nconst existing = new Set($input.all().map(i => i.json.key).filter(Boolean));\nreturn ROWS.filter(r => !existing.has(r.key)).map(json => ({ json }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
