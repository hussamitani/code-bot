        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Only this chat is served: telegram_chat_id in the data table codebot_settings\nconst ALLOWED_CHAT = String($input.all().map(i => i.json).find(r => r.key === 'telegram_chat_id')?.value ?? '').trim();\nif (!ALLOWED_CHAT) throw new Error('telegram_chat_id is missing in codebot_settings');\n// The bot's only Telegram trigger. Dispatches to: work | plan | connect | chat\n// Callback prefixes: p| and w| belong to CodeBot - /work, s| belongs to CodeBot - Planning. New workflows with buttons reserve their prefix here.\nconst u = $('Telegram Trigger').first().json;\nconst cq = u.callback_query;\nconst msg = u.message;\n// A discarded update leaves as route 'ignored' with the reason. No output of \"Where to?\" takes it, so the execution ends there and shows why.\nconst ignore = reason => [{ json: { route: 'ignored', reason } }];\nif (!cq && !msg) return ignore('update without a message or a button');\nconst chat = String(cq ? cq.message?.chat?.id : msg.chat?.id);\nif (chat !== ALLOWED_CHAT) return ignore(`chat ${chat} is not telegram_chat_id (${ALLOWED_CHAT}) in codebot_settings`);\n\nlet route = 'chat';\nif (cq) {\n  const data = String(cq.data || '');\n  if (/^[pw]\\|/.test(data)) route = 'work';\n  else if (/^s\\|/.test(data)) route = 'plan';\n  else return ignore(`button with an unknown prefix: ${data.slice(0, 20)}`);\n} else {\n  const t = String(msg.text || msg.caption || '').trim();\n  if (/^\\/work(@\\w+)?(\\s|$)/i.test(t)) route = 'work';\n  else if (/^\\/plan(@\\w+)?(\\s|$)/i.test(t)) route = 'plan';\n  // /connect <owner/repo|url>; \"connect <repo-url>\" without the slash works too\n  else if (/^\\/connect(@\\w+)?(\\s|$)/i.test(t) || /^connect\\s+(https?:\\/\\/)?(www\\.)?github\\.com\\/\\S+$/i.test(t)) route = 'connect';\n}\nreturn [{ json: { route, update: u } }];"
      },
